# Copy to .env.local for local overrides. .env.local is gitignored.
#
# IMPORTANT: every variable prefixed with VITE_ is compiled into the public
# JavaScript bundle and can be read by anyone. Only put public, non-secret
# configuration here. API keys and other credentials must live on the backend.

# Base URL of the WorthIT backend. Leave empty to use the local mock API.
VITE_API_BASE_URL=
